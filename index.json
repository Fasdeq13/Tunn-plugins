  "plugins": [
    {
      "id": "tunn-ad-shield",
      "name": "Блокировка рекламы и трекеров",
      "version": "1.0.0",
      "kinds": [
        "rules"
      ],
      "description": "Блокирует известные рекламные сети, счётчики и SDK-трекеры на уровне домена для всех приложений.",
      "file": "dist/tunn-ad-shield-1.0.0.zip",
